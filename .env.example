# En ligne (voir DEPLOIEMENT.md), définir sur Vercel : DEPLOY_TARGET=vercel, DATABASE_URL, DATABASE_TOKEN,
# MAIL_MODE=api, MAIL_PROVIDER, MAIL_API_KEY, MAIL_FROM, ADMIN_PASSWORD, SESSION_SECRET et, si besoin, RSVP_LIMITE.
# VERCEL est définie automatiquement par Vercel.

# Cible de déploiement : laisser vide en local, "vercel" en ligne
DEPLOY_TARGET=

# Base de données : fichier local par défaut ; en ligne, l'URL Turso et son jeton
DATABASE_URL=file:.data/local.db
DATABASE_TOKEN=

# E-mails : "outbox" (local, rien n'est envoyé : voir .data/outbox) ou "api"
MAIL_MODE=outbox
# Si MAIL_MODE=api : "brevo" ou "resend", la clé API et l'adresse d'expédition vérifiée
MAIL_PROVIDER=brevo
MAIL_API_KEY=
MAIL_FROM=
OUTBOX_DIR=.data/outbox

# Anti-spam : nombre d'envois de formulaire autorisés par adresse IP toutes les 10 minutes
RSVP_LIMITE=5

# Espace organisateur (/admin) : désactivé tant que ces deux valeurs manquent
ADMIN_PASSWORD=
# 32 caractères au moins ; pour en générer un : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
