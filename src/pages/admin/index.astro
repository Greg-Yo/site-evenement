---
import Admin from '../../layouts/Admin.astro';
import type { Reponse } from '../../lib/db';
import { abreviations, filtrer, lireFiltres, messageFlash, statistiques } from '../../lib/admin/reponses';
import { horodatageLocal, nombrePersonnes } from '../../lib/rsvp';
import { getDeps } from '../../lib/services';

const deps = await getDeps();
const ev = deps.ev;
const ids = ev.moments.map((m) => m.id);
const toutes = await deps.db.toutes();
const f = lireFiltres(Astro.url.searchParams, ids);
const flash = messageFlash(Astro.url.searchParams.get('ok'));
const affichees = filtrer(toutes, f);
const stats = statistiques(toutes, ids);
const abr = abreviations(ev.moments.map((m) => ({ id: m.id, titre: m.titre.fr })), 3);
const tuiles = [
  { n: stats.reponses, libelle: 'Réponses reçues' },
  { n: stats.foyers, libelle: 'Foyers confirmés' },
  { n: stats.personnes, libelle: 'Personnes attendues' },
  { n: stats.refus, libelle: 'Ne viendront pas' },
];
const moments = (r: Reponse) => {
  const choisis = ids.filter((id) => r.moments.includes(id));
  if (choisis.length === 0) return '—';
  return choisis.length === ids.length ? 'Tous' : choisis.map((id) => abr[id]).join(' · ');
};
// JJ/MM, dans le fuseau de l'événement.
const recuLe = (r: Reponse) => horodatageLocal(r.creeLe, ev.evenement.date_debut).slice(0, 5);
---
<Admin titre="Réponses" actif="reponses">
  <div class="entete">
    <h1>Réponses</h1>
    <div class="boutons">
      <a class="btn btn-contour btn-petit" href="/api/admin/export.csv"><span aria-hidden="true">⬇</span>{' '}Export CSV / Excel</a>
      <a class="btn btn-contour btn-petit" href="/api/admin/liste.pdf"><span aria-hidden="true">🖨</span>{' '}PDF liste des confirmés</a>
      <a class="btn btn-contour btn-petit" href="/api/admin/invitations.pdf"><span aria-hidden="true">📄</span>{' '}Toutes les invitations (PDF)</a>
    </div>
  </div>
  {flash && <p class={`flash ${flash.type}`} role={flash.type === 'ok' ? 'status' : 'alert'}>{flash.texte}</p>}
  <ul class="tuiles">
    {tuiles.map((t) => <li><b>{t.n}</b><span>{t.libelle}</span></li>)}
  </ul>
  <ul class="pastilles">
    {ev.moments.map((m) => <li>{m.titre.fr} : {stats.parMoment[m.id]}</li>)}
  </ul>
  <form class="filtres" method="get" action="/admin">
    <div class="champ recherche">
      <label for="q">Rechercher un nom ou un e-mail</label>
      <input id="q" name="q" type="search" value={f.q} />
    </div>
    <div class="champ">
      <label for="presence">Présence</label>
      <select id="presence" name="presence">
        <option value="tous" selected={f.presence === 'tous'}>Tous</option>
        <option value="oui" selected={f.presence === 'oui'}>Viennent</option>
        <option value="non" selected={f.presence === 'non'}>Ne viennent pas</option>
      </select>
    </div>
    <div class="champ">
      <label for="moment">Moment</label>
      <select id="moment" name="moment">
        <option value="" selected={f.moment === ''}>Tous les moments</option>
        {ev.moments.map((m) => <option value={m.id} selected={f.moment === m.id}>{m.titre.fr}</option>)}
      </select>
    </div>
    <button class="btn btn-plein btn-petit" type="submit">Filtrer</button>
  </form>
  <p class="compte">{affichees.length} réponse(s) affichée(s)</p>
  {toutes.length === 0 ? (
    <p class="vide">Aucune réponse pour l'instant.</p>
  ) : affichees.length === 0 ? (
    <p class="vide">Aucune réponse ne correspond à ces filtres.</p>
  ) : (
    <div class="defilement" tabindex="0" role="region" aria-label="Tableau des réponses">
      <table>
        <thead>
          <tr><th scope="col">Invité</th><th scope="col">Contact</th><th scope="col">Présence</th><th scope="col">Pers.</th><th scope="col">Moments</th><th scope="col">Reçu le</th><th scope="col">Actions</th></tr>
        </thead>
        <tbody>
          {affichees.map((r) => (
            <tr>
              <td>
                <b>{r.nom}</b>{r.langue === 'en' && <>{' '}<span class="pastille langue">EN</span></>}
                {r.accompagnants.map((a) => <small class="ligne">+ {a}</small>)}
              </td>
              <td>{r.email}<small class="ligne">{r.telephone ?? '—'}</small></td>
              <td>{r.vient ? <span class="pastille oui">Vient</span> : <span class="pastille non">Ne vient pas</span>}</td>
              <td>{nombrePersonnes(r)}</td>
              <td>{moments(r)}</td>
              <td>{recuLe(r)}</td>
              <td>
                <div class="actions">
                  {r.vient && (
                    <a class="action" href={`/api/admin/reponses/${r.id}/invitation.pdf`} aria-label={`Invitation PDF de ${r.nom}`}><span aria-hidden="true">📄</span></a>
                  )}
                  <form method="post" action={`/api/admin/reponses/${r.id}/renvoyer`}>
                    <button class="action" type="submit" aria-label={`Renvoyer l’e-mail à ${r.nom}`}><span aria-hidden="true">✉</span></button>
                  </form>
                  <a class="action" href={`/admin/reponses/${r.id}/modifier`} aria-label={`Modifier la réponse de ${r.nom}`}><span aria-hidden="true">✎</span></a>
                  <a class="action" href={`/admin/reponses/${r.id}/supprimer`} aria-label={`Supprimer la réponse de ${r.nom}`}><span aria-hidden="true">🗑</span></a>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</Admin>
<style>
  .entete { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px 16px; margin: 0 0 16px; }
  h1 { margin: 0; font-size: 1.6rem; }
  .boutons { display: flex; flex-wrap: wrap; gap: 8px; }
  ul { list-style: none; margin: 0; padding: 0; }
  .flash { border-radius: 14px; padding: 14px 18px; font-weight: 700; margin: 0 0 18px; }
  .flash.ok { background: #dff3e3; color: #1e6b32; }
  .flash.erreur { background: #f6dede; color: #8d2323; }
  .tuiles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-bottom: 18px; }
  .tuiles li { background: #fff; border-radius: 14px; padding: 14px 16px; box-shadow: 0 3px 10px rgba(58,36,25,.07); }
  .tuiles b { display: block; font-size: 1.9rem; line-height: 1.1; color: var(--c-principale-fonce); }
  .tuiles span { display: block; font-size: .85rem; line-height: 1.3; font-weight: 700; color: var(--c-texte-doux); }
  .pastilles { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 18px; }
  .pastilles li { background: var(--c-douce); border-radius: 20px; padding: 5px 12px; font-size: .85rem; font-weight: 700; }
  .filtres { display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-end; margin-bottom: 10px; }
  .champ { display: flex; flex-direction: column; min-width: 0; }
  .champ.recherche { flex: 1 1 240px; }
  label { font-size: .8rem; font-weight: 700; }
  input, select { border: 2px solid var(--c-texte-doux); border-radius: 10px; padding: 8px 10px; font: inherit; font-size: .95rem; background: #fff; color: var(--c-texte); max-width: 100%; }
  .filtres button { box-shadow: none; }
  .compte { font-size: .85rem; color: var(--c-texte-doux); font-weight: 700; margin: 0 0 8px; }
  .vide { background: #fff; border-radius: 14px; padding: 18px; text-align: center; margin: 0; }
  .defilement { overflow-x: auto; border-radius: 14px; box-shadow: 0 3px 10px rgba(58,36,25,.07); }
  table { width: 100%; border-collapse: collapse; background: #fff; font-size: .85rem; }
  th { text-align: left; background: #f5ebe2; padding: 10px 12px; font-size: .75rem; text-transform: uppercase; letter-spacing: .04em; white-space: nowrap; }
  td { padding: 10px 12px; border-top: 1px solid #eadfd5; vertical-align: middle; }
  .ligne { display: block; }
  .actions { display: flex; gap: 6px; white-space: nowrap; }
  .actions form { margin: 0; }
  .action {
    display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 10px;
    border: 2px solid #eadfd5; background: #fff; color: var(--c-texte); font: inherit; font-size: 1rem; text-decoration: none; cursor: pointer;
  }
  .action:hover { border-color: var(--c-texte-doux); }
  .pastille { display: inline-block; border-radius: 20px; padding: 2px 10px; font-weight: 800; font-size: .75rem; white-space: nowrap; }
  .oui { background: #dff3e3; color: #1e6b32; }
  .non { background: #f6dede; color: #8d2323; }
  .langue { background: var(--c-douce); color: var(--c-texte); padding: 1px 7px; }
  @media (max-width: 760px) {
    .tuiles { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  }
</style>
